rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive validation helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    // Health check test doc for testConnection()
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // Assignments collection (per classCode)
    match /assignments/{assignmentId} {
      function isValidAssignment(data) {
        return data.keys().hasAll(['id', 'classCode', 'subjects', 'createdAt'])
          && data.keys().hasOnly(['id', 'classCode', 'pin', 'subjects', 'teacherName', 'createdAt', 'note'])
          && data.id is string && data.id.size() <= 128
          && data.classCode is string && data.classCode.size() <= 32
          && (!('pin' in data) || (data.pin is string && data.pin.size() <= 32))
          && data.subjects is list && data.subjects.size() <= 20
          && (!('teacherName' in data) || (data.teacherName is string && data.teacherName.size() <= 100))
          && (!('note' in data) || (data.note is string && data.note.size() <= 500))
          && data.createdAt is string && data.createdAt.size() <= 64;
      }

      allow read: if true;
      allow create, update: if isValidId(assignmentId) && isValidAssignment(incoming());
      allow delete: if true;
    }

    // Student roster accounts collection
    match /students/{studentId} {
      function isValidStudent(data) {
        return data.keys().hasAll(['id', 'studentName', 'classCode', 'createdAt'])
          && data.keys().hasOnly(['id', 'studentName', 'classCode', 'studentCode', 'gender', 'pin', 'createdAt', 'note'])
          && data.id is string && data.id.size() <= 128
          && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100
          && data.classCode is string && data.classCode.size() <= 32
          && (!('studentCode' in data) || (data.studentCode is string && data.studentCode.size() <= 64))
          && (!('gender' in data) || (data.gender is string && data.gender.size() <= 20))
          && (!('pin' in data) || (data.pin is string && data.pin.size() <= 32))
          && (!('note' in data) || (data.note is string && data.note.size() <= 500))
          && data.createdAt is string && data.createdAt.size() <= 64;
      }

      allow read: if true;
      allow create, update: if isValidId(studentId) && isValidStudent(incoming());
      allow delete: if true;
    }

    // Classes collection
    match /classes/{classId} {
      function isValidClass(data) {
        return data.keys().hasAll(['id', 'classCode'])
          && data.keys().hasOnly(['id', 'classCode', 'name', 'grade', 'createdAt', 'teacherName'])
          && data.id is string && data.id.size() <= 64
          && data.classCode is string && data.classCode.size() <= 32
          && (!('name' in data) || (data.name is string && data.name.size() <= 100))
          && (!('grade' in data) || (data.grade is number || data.grade is string))
          && (!('teacherName' in data) || (data.teacherName is string && data.teacherName.size() <= 100))
          && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
      }

      allow read: if true;
      allow create, update: if isValidId(classId) && isValidClass(incoming());
      allow delete: if true;
    }

    // Student exercise results collection
    match /results/{resultId} {
      function isValidResult(data) {
        return data.keys().hasAll(['id', 'studentName', 'classCode', 'subjectId', 'lessonId', 'score', 'accuracy', 'completedAt'])
          && data.keys().hasOnly(['id', 'studentName', 'classCode', 'pin', 'subjectId', 'lessonId', 'lessonTitle', 'score', 'accuracy', 'timeSpentSeconds', 'completedAt'])
          && data.id is string && data.id.size() <= 128
          && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100
          && data.classCode is string && data.classCode.size() <= 32
          && (!('pin' in data) || (data.pin is string && data.pin.size() <= 32))
          && data.subjectId is string && data.subjectId.size() <= 64
          && (data.lessonId is number || (data.lessonId is string && data.lessonId.size() <= 64))
          && (!('lessonTitle' in data) || (data.lessonTitle is string && data.lessonTitle.size() <= 200))
          && data.score is number && data.score >= 0 && data.score <= 100
          && data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100
          && (!('timeSpentSeconds' in data) || (data.timeSpentSeconds is number && data.timeSpentSeconds >= 0))
          && data.completedAt is string && data.completedAt.size() <= 64;
      }

      allow read: if true;
      allow create, update: if isValidId(resultId) && isValidResult(incoming());
      allow delete: if true;
    }

    // Student digital achievement badges
    match /achievements/{recordId} {
      function isValidAchievement(data) {
        return data.keys().hasAll(['id', 'studentName', 'classCode', 'achievementId', 'unlockedAt'])
          && data.keys().hasOnly(['id', 'studentName', 'classCode', 'achievementId', 'unlockedAt'])
          && data.id is string && data.id.size() <= 128
          && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100
          && data.classCode is string && data.classCode.size() <= 32
          && data.achievementId is string && data.achievementId.size() <= 64
          && data.unlockedAt is string && data.unlockedAt.size() <= 64;
      }

      allow read: if true;
      allow create: if isValidId(recordId) && isValidAchievement(incoming());
      allow update, delete: if false;
    }

    // Teacher & Admin accounts
    match /teachers/{username} {
      function isValidTeacher(data) {
        return data.keys().hasAll(['username', 'name', 'school', 'createdAt'])
          && data.keys().hasOnly(['username', 'password', 'name', 'role', 'school', 'assignedClasses', 'createdAt'])
          && data.username is string && data.username.size() >= 1 && data.username.size() <= 64
          && (!('password' in data) || (data.password is string && data.password.size() <= 128))
          && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
          && (!('role' in data) || (data.role in ['admin', 'teacher']))
          && data.school is string && data.school.size() >= 1 && data.school.size() <= 200
          && (!('assignedClasses' in data) || (data.assignedClasses is list && data.assignedClasses.size() <= 50))
          && data.createdAt is string && data.createdAt.size() <= 64;
      }

      allow read: if true;
      allow create, update: if isValidId(username) && isValidTeacher(incoming());
      allow delete: if isValidId(username) && username != 'admin';
    }
  }
}
